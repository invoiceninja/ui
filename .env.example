VITE_API_URL=
VITE_IS_HOSTED=false
VITE_APP_TITLE="Invoice Ninja"

# Hosted production telemetry only. Self-hosted builds must leave these empty.
VITE_SENTRY_URL=
VITE_SENTRY_ENVIRONMENT=
# Optional outside CI; Cloudflare Pages uses CF_PAGES_COMMIT_SHA automatically.
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Comma-separated API origins that accept sentry-trace and baggage headers.
VITE_SENTRY_TRACE_PROPAGATION_TARGETS=

# Required for hosted builds. The token needs org:ci scope and must never be
# exposed to the browser (do not give it a VITE_ prefix).
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Supported values: "browser", "hash"
# VITE_ROUTER=hash
VITE_WHITELABEL_INVOICE_URL=https://invoiceninja.invoicing.co/client/subscriptions/O5xe7Rwd7r/purchase

VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=

VITE_DEMO_ENDPOINT=https://demo.invoiceninja.com
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

PLAYWRIGHT_BASE_URL=http://localhost:4173

VITE_IS_TEST=true

VITE_FACEBOOK_PIXEL_ID=

VITE_CLOUDFLARE_SITE_ID=

VITE_ROUTER=browser

VITE_HOSTED_SHOW_SMTP_SETTINGS=true

VITE_DISABLE_PREVENT_NAVIGATION_FEATURE=true

VITE_ENABLE_PEPPOL_STANDARD=true

VITE_ENABLE_DISCARD_CHANGES_TRACKING=false

VITE_PUSHER_APP_KEY=

VITE_RETURN_NUMBER_FIELD=false

VITE_HOSTED_STRIPE_PK=

VITE_ENABLE_NEW_ACCOUNT_MANAGEMENT=false
VITE_SHOW_ACCOUNT_PLAN_EXPIRED_BANNER=false

VITE_ENABLE_APPLE_LOGIN=false

VITE_DISABLE_FEEDBACK_FEATURE=true

# DocuNinja is always enabled on hosted; opt in for self-hosted/local dev.
VITE_ENABLE_DOCUNINJA=false

VITE_DISABLE_QUICKBOOKS_INTEGRATION=true
